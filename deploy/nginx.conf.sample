# HeartGRN viewer — nginx site snapshot
# ---------------------------------------------------------------------------
# Deployment location on the prod box:
#     /etc/nginx/sites-available/heartgrn   (symlinked from sites-enabled/)
#
# This file is a frozen reference of the live config. Do NOT include it via
# `include` — it is documentation. To install on a fresh host:
#     1. Replace 178-105-162-190.nip.io with your real domain (3 places below).
#     2. sudo cp this file to /etc/nginx/sites-available/heartgrn
#     3. sudo ln -s /etc/nginx/sites-available/heartgrn /etc/nginx/sites-enabled/
#     4. Generate htpasswd:
#          sudo htpasswd -c /etc/nginx/heartgrn.htpasswd heartlink
#     5. Issue the TLS cert via certbot --nginx -d <your-domain>
#     6. sudo nginx -t && sudo systemctl reload nginx
#
# DEPENDENCIES
#   - /etc/nginx/heartgrn.htpasswd                          (Basic Auth users)
#   - heartgrn-backend.service listening on 127.0.0.1:8766  (systemd unit)
#   - Let's Encrypt cert at /etc/letsencrypt/live/<domain>/
#   - limit_req_zone for the 'chat' zone — add to /etc/nginx/nginx.conf or a
#     snippet under /etc/nginx/conf.d/. Recommended:
#         limit_req_zone $binary_remote_addr zone=chat:10m rate=30r/m;
#     (≈ 30 chat requests per minute per IP, burst 10 nodelay handled below)
#
# COMMITTED ON 2026-05-20 from the live prod box.
# ---------------------------------------------------------------------------

server {
    server_name 178-105-162-190.nip.io;

    root /opt/heartgrn/hub;
    index index.html;

    access_log /var/log/nginx/heartgrn.access.log;
    error_log /var/log/nginx/heartgrn.error.log warn;

    client_max_body_size 2m;

    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

    # /healthz: Basic Auth 免除 (monitor 用)
    location = /healthz {
        auth_basic off;
        proxy_pass http://127.0.0.1:8766;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # 以下すべて Basic Auth 必要
    auth_basic "HeartGRN staging";
    auth_basic_user_file /etc/nginx/heartgrn.htpasswd;

    # /chat: rate limit + streaming friendly timeout
    location = /chat {
        limit_req zone=chat burst=10 nodelay;
        proxy_pass http://127.0.0.1:8766;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
        proxy_buffering off;
    }


    # /chat/stream: SSE endpoint, MUST NOT be buffered by nginx
    location = /chat/stream {
        limit_req zone=chat burst=10 nodelay;
        proxy_pass http://127.0.0.1:8766;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 600s;
        proxy_send_timeout 600s;
        proxy_buffering off;
        proxy_cache off;
        chunked_transfer_encoding on;
        gzip off;
    }

    # /ag1/* (status/score/render)
    location /ag1/ {
        proxy_pass http://127.0.0.1:8766;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;
    }

    # /literature/*
    location /literature/ {
        proxy_pass http://127.0.0.1:8766;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }


    # /gene/* /snp/* (lookup endpoints for cross-payload search)
    location /gene/ {
        proxy_pass http://127.0.0.1:8766;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 30s;
    }
    location /snp/ {
        proxy_pass http://127.0.0.1:8766;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 30s;
    }
    # /citations/* (user-curated credible vote API + curate trigger)
    location /citations/ {
        proxy_pass http://127.0.0.1:8766;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }


    # 静的ファイル (hub/* — index.html, payloads/, assets/ など)
    location / {
        try_files $uri $uri/ =404;
    }

    listen [::]:443 ssl ipv6only=on; # managed by Certbot
    listen 443 ssl; # managed by Certbot
    ssl_certificate /etc/letsencrypt/live/178-105-162-190.nip.io/fullchain.pem; # managed by Certbot
    ssl_certificate_key /etc/letsencrypt/live/178-105-162-190.nip.io/privkey.pem; # managed by Certbot
    include /etc/letsencrypt/options-ssl-nginx.conf; # managed by Certbot
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem; # managed by Certbot

}
server {
    if ($host = 178-105-162-190.nip.io) {
        return 301 https://$host$request_uri;
    } # managed by Certbot


    listen 80;
    listen [::]:80;
    server_name 178-105-162-190.nip.io;
    return 404; # managed by Certbot


}
